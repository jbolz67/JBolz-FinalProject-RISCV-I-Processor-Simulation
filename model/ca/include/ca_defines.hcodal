#ifndef CA_DEFINES_HCODAL
#define CA_DEFINES_HCODAL

#include "config.hcodal"

// -------------------------------------------------------------------------------------------------
// Signal size
// -------------------------------------------------------------------------------------------------
// Phase 6: Add RFF and FWD
#define RFF1_W         bitsizeof(enum rff1_sel)
#define RFF2_W         bitsizeof(enum rff2_sel)
#define FWDA_W         bitsizeof(enum fwdA_sel)
#define FWDB_W         bitsizeof(enum fwdB_sel)
// Phase 7: Immed
#define IMMED_W        bitsizeof(enum immed)
// Phase 7: Branch
#define BRANCH_W       bitsizeof(enum branchop)

#define ALUOP_W        bitsizeof(enum aluop)
#define ALUOP_W        bitsizeof(enum aluop)
#define REGWRITE_W     bitsizeof(enum regwrite)
// Phase 7: src1
#define SRC1_W         bitsizeof(enum src1)
#define SRC2_W         bitsizeof(enum src2)
// Phase 7: Branch Address
#define BRADD_W        bitsizeof(enum bradd)
#define HALT_W         bitsizeof(enum halt)

// Phase 7: rfwt
#define RFWT_W         bitsizeof(enum rfwt)

// Phase 8: memop
#define MEMOP_W        bitsizeof(enum mem_ops)
// -------------------------------------------------------------------------------------------------
// Enumerations
// -------------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------------------------
// IF stage
// -------------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------------------------
// ID stage
// -------------------------------------------------------------------------------------------------
// Register File Forwarding
enum rff1_sel
{
    RFF1_WB_RD,
    RFF1_RS1,
};

enum rff2_sel
{
    RFF2_WB_RD,
    RFF2_RS2,
};
// Phase 7: Immed
enum immed
{
    IMM_NONE,
    IMM_ITYPE,
    IMM_STYPE,
    IMM_BTYPE,
    IMM_UTYPE,
    IMM_JTYPE,
};
// Phase 7: brnchop
// Phase 9: Add new Brnchops BEQ and BNE for Execute Stage
enum branchop
{
    BRANCH_FALSE,
    BRANCH_TRUE, // JALR
    BRANCH_COND_TRUE, //  BGE, BGEU
    BRANCH_COND_FALSE, // BLT, BLTU
    BRANCH_BEQ,
    BRANCH_BNE,
    BRANCH_JAL, // JAL
};
// Phase 8: Memory
enum mem_ops
{
    MEM_NOP,
    MEM_LB,
    MEM_LBU,
    MEM_LH,
    MEM_LHU,
    MEM_LW,
    MEM_SB,
    MEM_SH,
    MEM_SW,
};
// -------------------------------------------------------------------------------------------------
// EX stage
// -------------------------------------------------------------------------------------------------
// Forwarding Selects
enum fwdA_sel
{
    FWDA_src1,
    FWDA_WB_RD,
    FWDA_ME_RD,
};

enum fwdB_sel
{
    FWDB_src2,
    FWDB_WB_RD,
    FWDB_ME_RD,
};

// ALU function codes
enum aluop
{
    ALU_NOP,
    ALU_ADD,
    //Phase 7
    ALU_AND,
    ALU_SUB,
    ALU_OR,
    ALU_XOR,
    ALU_SLT,
    ALU_SLTU,
    ALU_SLL,
    ALU_SRL,
    ALU_SRA,
};

enum regwrite
{
    WE_FALSE,
    WE_TRUE,
};

//Phase 7
enum src1
{
    ALU_SRC1_REG,
    ALU_SRC1_ZERO,
    ALU_SRC1_PC,
};

enum src2
{
    ALU2_REG,
    ALU2_IMM,
};

// Phase 7: BRADD target address
enum bradd
{
    BRADD_ADDR,
    BRADD_ALU,
};

enum halt
{
    HALT_NOHALT,
    HALT_HALT,
};


// -------------------------------------------------------------------------------------------------
// ME stage
// -------------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------------------------
// WB stage
// -------------------------------------------------------------------------------------------------
enum rfwt
{
    RFWT_ALU,
    RFWT_PC,
    RFWT_MEM,
};
// -------------------------------------------------------------------------------------------------
// Auxiliary definitions
// -------------------------------------------------------------------------------------------------

#define DONT_CARE           0
#define NOP_INSTRUCTION     ITYPE_ADDI
#endif // CA_DEFINES_HCODAL

