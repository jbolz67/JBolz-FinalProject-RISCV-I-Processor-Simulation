#include "ca_defines.hcodal"
#include "config.hcodal"

// -------------------------------------------------------------------------------------------------
// Memory Stage
// -------------------------------------------------------------------------------------------------
event me : pipeline(pipe.ME)
{
    // Phase 8:
    use me_memory;
    use me_output;

    semantics
    {
        // Phase 7: Add Branch Logic
        switch (r_me_brnchop) {
            case BRANCH_FALSE:
                s_me_pcsrc = 0;
                break;
            case BRANCH_TRUE:
                s_me_pcsrc = 0;
                break;
            case BRANCH_COND_TRUE:
                s_me_pcsrc = r_me_zero;
                break;
            case BRANCH_COND_FALSE:
                s_me_pcsrc = !(r_me_zero);
                break;
            // Phase 9: Add More Cases
            case BRANCH_BEQ:
                s_me_pcsrc = 0;
                break;
            case BRANCH_BNE:
                s_me_pcsrc = 0;
                break;
            case BRANCH_JAL:
                s_me_pcsrc = 0;
                break;
            default:
                s_me_pcsrc = 0;
                codasip_fatal(BRANCH_ERROR, "Default case: %d\n", s_me_pcsrc);
                break;
        }
        // Phase 8:
        me_memory();
        me_output();
    };
};

event me_memory : pipeline(pipe.ME)
{
    semantics
    {
        uint1 data_ready;
        uint1 data_response;
        uint32 load_data_temp;
        
        if(r_me_memop == MEM_NOP){
            data_ready = 1;
            data_response = 0;
            load_data_temp = 0;
        }else{
            ldst.transport(CP_PHS_DATA, data_ready, data_response, load_data_temp, r_me_wtdat);
            s_me_decoded_data = ldst.decode_data(load_data_temp, r_me_alu, r_me_memsize);
        }

        switch(r_me_memop)
        {
            case MEM_NOP:
                s_me_mem_result = DONT_CARE;
                break;
            case MEM_LB:
                s_me_mem_result = (int32) (int8) s_me_decoded_data;
                break; 
            case MEM_LBU:
                s_me_mem_result = (uint32) (uint8) s_me_decoded_data;
                break; 
            case MEM_LH:
                s_me_mem_result = (int32) (int16) s_me_decoded_data;
                break; 
            case MEM_LHU:
                s_me_mem_result = (uint32) (uint16) s_me_decoded_data;
                break; 
            case MEM_LW:
                s_me_mem_result = (int32) s_me_decoded_data;
                break; 
            case MEM_SB:
                s_me_mem_result = DONT_CARE;
                break;
            case MEM_SH:
                s_me_mem_result = DONT_CARE;
                break;
            case MEM_SW:
                s_me_mem_result = DONT_CARE;
                break;
            default:
                s_me_mem_result = 0;
                codasip_fatal(READ_ERROR, "Default case: %d\n", s_me_mem_result);
                break;
        }
        s_me_stall = ((data_response == 0) & (data_ready == 0));
    };
};

event me_output : pipeline(pipe.ME)
{
    semantics
    {
        r_wb_pc = r_me_pc;
        r_wb_alu = r_me_alu;
        r_wb_regwrite = r_me_regwrite;
        r_wb_rd = r_me_rd;
        r_wb_instr = r_me_instr;
        // Phase 7: Add rfwt register
        r_wb_rfwt_sel = r_me_rfwt_sel;
        // Phase 8: Pipeline Memory Value
        r_wb_memdat = s_me_mem_result;
    };
};
