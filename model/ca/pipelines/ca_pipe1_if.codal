// -------------------------------------------------------------------------------------------------
// Fetch stage
// -------------------------------------------------------------------------------------------------

#include "config.hcodal"
#include "ca_defines.hcodal"

event fe : pipeline(pipe.IF)
{
    use if_output;

    semantics
    {
        // -----------------------------------------------------------------------------------------
        // Pipeline control
        // -----------------------------------------------------------------------------------------
        // Instruction Memory Interface (Memory part, OpType, Read/Write, Base Address, OpSize)
        if_code.transport(CP_PHS_ADDRESS, CP_AHB_NONSEQ, CP_AHB_READ, r_pc, CP_AHB_SIZE_32);

        // Phase 8: Prevent PC from updating if stalled
        if(s_id_stall == 1){
            s_if_nextpc = r_pc;
        }else{
            // Update Next PC
            s_if_nextpc = r_pc + INSTR_SIZE;
        }
        

        // Phase 7: Update PC Source with Multiplexor
        // Phase 9: Updated for Fast Branches and JAL
        if(s_me_pcsrc){
            s_if_pcin = r_me_target_addr;
        }else if(s_ex_take_branch){
            s_if_pcin = s_ex_target_address;
        }else if(s_id_take_jump){
            s_if_pcin = s_id_jalpc;
        }else{
            s_if_pcin = s_if_nextpc;
        }
        
        // Phase 9: Update Clear Signals with s_ex_take_branch
        // Set all the clear signals. Phase 7: Update ex and me clear
        s_id_clear = 0;
        // Phase 8: Add Or with s_id_loadhaz
        s_ex_clear = (s_ex_take_branch | s_me_pcsrc | s_id_loadhaz);
        s_wb_clear = 0;
        s_me_clear = s_me_pcsrc;

        // Set the local stall signal.
        s_if_stall = 0;

        // Update the registers
        if_output();
    };
};

event if_output : pipeline(pipe.IF)
{
    semantics
    {
        //Update Registers
        r_id_pc = r_pc;
        // Phase 7: Updated to pcin, r_id_clear updated to s_me_pcsrc
        // Phase 9: r_id_clear updated to s_id_take_jump or s_ex_take_branch
        r_pc = s_if_pcin;
        r_id_clear = (s_id_take_jump | s_ex_take_branch | s_me_pcsrc);
        // Phase 8:
        r_id_stall = s_id_stall;
    };
};
