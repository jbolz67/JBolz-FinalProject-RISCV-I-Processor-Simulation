#include "debug.hcodal"
#include "ca_defines.hcodal"
#include "config.hcodal"
// -------------------------------------------------------------------------------------------------
// Write-Back Stage
// -------------------------------------------------------------------------------------------------

event wb : pipeline(pipe.WB)
{
    semantics
    {
        // Phase 7: Add Writeback Options
        // Adder
        s_wb_pc = r_wb_pc + INSTR_SIZE;

        switch (r_wb_rfwt_sel)
        {
            case RFWT_ALU:
                s_wb_result = r_wb_alu;
                break;
            case RFWT_PC:
                s_wb_result = s_wb_pc;
                break;
            // Phase 8:
            case RFWT_MEM:
                s_wb_result = r_wb_memdat;
                break;
            default:
                s_wb_result = 0;
                codasip_fatal(RFWT_ERROR, "Default case: %d\n", s_wb_result);
                break;
        }

        if (r_wb_regwrite)
        {
            // Add Check to Ensure that x0 is always zero, i.e. can't write to x0
            if(r_wb_rd != 0){
                rf_xpr.wrt0[r_wb_rd] = s_wb_result;
            }
            codasip_info(INFO_RF_WRITE, "rf_xpr[%d] = 0x%x", r_wb_rd, r_wb_alu);
        }

        // Set local stall.
        s_wb_stall = 0;

    };
};
